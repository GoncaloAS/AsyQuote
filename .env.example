# AsyQuote environment template.
# Copy to .env and fill in real values. Never commit .env.
#   cp .env.example .env
#
# base.py only reads .env when DJANGO_READ_DOT_ENV_FILE is true.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
DJANGO_READ_DOT_ENV_FILE=True
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_DEBUG=True

# Django refuses to start on an empty value, so a throwaway one ships here to
# keep `cp .env.example .env && docker compose up` working out of the box.
# Replace it for anything that is not local development. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=insecure-local-development-key-replace-me

# Comma-separated. Required by config/settings/production.py.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Matches the docker-compose service. For a host Postgres install use:
#   postgres://USER:PASSWORD@127.0.0.1:5432/asyquote
DATABASE_URL=postgres://asyquote:asyquote@postgres:5432/asyquote

# Consumed by the postgres container on first boot.
POSTGRES_DB=asyquote
POSTGRES_USER=asyquote
POSTGRES_PASSWORD=asyquote

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Signup uses mandatory email verification. The default local backend prints
# the verification link to the console, so no SMTP server is needed to sign up.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=AsyQuote <noreply@localhost>
DJANGO_ADMIN_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# reCAPTCHA v2 (signup form)
# ---------------------------------------------------------------------------
# Blank means "use Google's public test keys", which always validate and are
# fine for local development. Real keys: https://www.google.com/recaptcha/admin
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Wagtail
# ---------------------------------------------------------------------------
WAGTAILADMIN_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Scraper (scrappers/peixoto2.py)
# ---------------------------------------------------------------------------
# Only needed if the supplier site requires a browser session.
SCRAPER_COOKIE=

# ---------------------------------------------------------------------------
# Production only (config/settings/production.py)
# ---------------------------------------------------------------------------
# DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_ADMIN_URL=
REDIS_URL=redis://redis:6379/0
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
